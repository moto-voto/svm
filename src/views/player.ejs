<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title><%= seasons.filter(s => s.isCurrent)[0]?.title || 'SVM' %></title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome CDN for MX Player icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        /* Custom scrollbars and gesture overlay styling */
        body {
            user-select: none;
            -webkit-user-select: none;
            touch-action: manipulation;
            background-color: #0d0d0d;
            font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        }

        /* Custom Range Slider for Progress */
        input[type=range].mx-progress {
            -webkit-appearance: none;
            appearance: none;
            width: 100%;
            height: 14px;
            background: transparent;
            cursor: pointer;
        }
        input[type=range].mx-progress:focus {
            outline: none;
        }
        input[type=range].mx-progress::-webkit-slider-runnable-track {
            width: 100%;
            height: 4px;
            cursor: pointer;
            background: rgba(255, 255, 255, 0.3);
            border-radius: 2px;
        }
        input[type=range].mx-progress::-moz-range-track {
            width: 100%;
            height: 4px;
            cursor: pointer;
            background: rgba(255, 255, 255, 0.3);
            border-radius: 2px;
        }
        input[type=range].mx-progress::-webkit-slider-thumb {
            height: 12px;
            width: 12px;
            border-radius: 50%;
            background: #ffffff;
            cursor: pointer;
            -webkit-appearance: none;
            margin-top: -4px;
            box-shadow: 0 0 6px rgba(255, 255, 255, 0.8);
        }
        input[type=range].mx-progress::-moz-range-thumb {
            height: 12px;
            width: 12px;
            border-radius: 50%;
            background: #ffffff;
            cursor: pointer;
            border: none;
            box-shadow: 0 0 6px rgba(255, 255, 255, 0.8);
        }
        
        /* Brightness Filter Overlay */
        #brightness-overlay {
            pointer-events: none;
            transition: background-color 0.05s linear;
        }

        /* Smooth UI Control Fade Transitions */
        .control-fade {
            transition: opacity 0.3s ease, visibility 0.3s ease;
        }

        /* Center OSD Icon Animations */
        .osd-box {
            backdrop-filter: blur(8px);
            background: rgba(0, 0, 0, 0.75);
            border: 1px solid rgba(255, 255, 255, 0.15);
        }

        /* Custom Scrollbar */
        .custom-scrollbar::-webkit-scrollbar {
            width: 6px;
        }
        .custom-scrollbar::-webkit-scrollbar-track {
            background: rgba(0, 0, 0, 0.3);
            border-radius: 8px;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.2);
            border-radius: 8px;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover {
            background: rgba(59, 130, 246, 0.8);
        }
        /* Firefox scrollbar support */
        .custom-scrollbar {
            scrollbar-width: thin;
            scrollbar-color: rgba(255, 255, 255, 0.2) rgba(0, 0, 0, 0.3);
        }
    </style>
</head>
<body class="h-screen w-screen overflow-hidden flex flex-col justify-center items-center bg-black text-white">

    <!-- Player Wrapper Container -->
    <div id="player-container" class="relative w-full h-full max-w-6xl max-h-[90vh] bg-black overflow-hidden flex items-center justify-center shadow-2xl group">
        
        <!-- HTML5 Video Element -->
        <video id="main-video" class="w-full h-full object-contain" playsinline preload="auto">
            <source src="https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/BigBuckBunny.mp4" type="video/mp4">
            Your browser does not support HTML5 video.
        </video>

        <!-- Simulated Screen Brightness Overlay Layer -->
        <div id="brightness-overlay" class="absolute inset-0 z-10 bg-black/0"></div>

        <!-- Gesture Touch Target Areas (Left = Brightness, Right = Volume) -->
        <div id="gesture-layer" class="absolute inset-0 z-20 flex">
            <div id="touch-left" class="w-1/2 h-full cursor-pointer"></div>
            <div id="touch-right" class="w-1/2 h-full cursor-pointer"></div>
        </div>

        <!-- Center OSD Display (Volume / Brightness / Seek Feedback) -->
        <div id="center-osd" class="absolute z-30 pointer-events-none opacity-0 transform scale-95 transition-all duration-200 flex flex-col items-center justify-center">
            <div class="osd-box rounded-2xl px-8 py-5 flex flex-col items-center justify-center shadow-2xl">
                <i id="osd-icon" class="fa-solid fa-running text-4xl mb-2 text-white"></i>
                <span id="osd-text" class="text-3xl font-extrabold tracking-wider text-white">30%</span>
                <span id="osd-subtext" class="text-xs text-gray-300 mt-1 uppercase tracking-widest hidden">Speed</span>
            </div>
        </div>

        <!-- Loading Overlay (Season Switch / Episode Load) -->
        <div id="loading-overlay" class="absolute inset-0 z-40 bg-black/80 backdrop-blur-md flex flex-col items-center justify-center space-y-4 opacity-0 pointer-events-none transition-opacity duration-300">
            <div class="relative w-16 h-16 flex items-center justify-center">
                <div class="absolute w-16 h-16 border-4 border-blue-500/20 border-t-blue-500 rounded-full animate-spin"></div>
                <i class="fa-solid fa-play text-blue-400 text-xl"></i>
            </div>
            <div class="text-center">
                <p id="loading-title" class="text-lg font-semibold text-white">Loading Season...</p>
                <p id="loading-subtitle" class="text-xs text-gray-400 mt-1">Fetching episode list</p>
            </div>
        </div>

        <!-- Unlocked Floating Lock Button (Shows brief icon when controls hide or lock active) -->
        <button id="unlock-btn" class="absolute left-6 top-1/2 -translate-y-1/2 z-50 bg-black/60 hover:bg-black/80 text-white p-4 rounded-full border border-white/20 shadow-lg hidden">
            <i class="fa-solid fa-lock text-xl text-blue-400"></i>
        </button>

        <!-- MX Player Control Overlays Layer -->
        <div id="controls-overlay" class="control-fade absolute inset-0 z-30 flex flex-col justify-between bg-gradient-to-b from-black/80 via-transparent to-black/90 p-4 sm:p-6 opacity-100">
            
            <!-- Top Navigation Bar -->
            <div class="flex items-center justify-between w-full">
                <!-- Left Section: Back, Title -->
                <div class="flex items-center space-x-4">
                    <button id="btn-back" class="text-white hover:text-blue-400 p-2 transition-colors">
                        <i class="fa-solid fa-arrow-left text-xl sm:text-2xl"></i>
                    </button>
                    <div class="flex flex-col">
                        <h1 id="video-title" class="text-sm sm:text-base font-semibold truncate max-w-[180px] sm:max-w-md text-gray-100">
                            S01E01 - Pilot
                        </h1>
                        <span id="series-subtitle" class="text-xs text-gray-400">Season 1 • Episode 1 of 4</span>
                    </div>
                </div>

                <!-- Right Section: Screen Rotate, HW Badge, Audio Track, Menu -->
                <div class="flex items-center space-x-3 sm:space-x-4 text-sm sm:text-base">
                    <!-- Orientation Toggle Button -->
                    <button id="btn-rotate" class="hover:text-blue-400 text-gray-200 p-1.5 transition-colors" title="Toggle Orientation">
                        <i class="fa-solid fa-rotate text-lg"></i>
                    </button>

                    <!-- HW Decoder Badge -->
                    <button id="btn-decoder" class="px-2 py-0.5 border border-white/40 text-xs font-bold rounded hover:bg-white/10 text-gray-200">
                        HW
                    </button>

                    <!-- Audio Track Picker -->
                    <button id="btn-audio" class="hover:text-blue-400 text-gray-200 p-1.5 transition-colors" title="Audio Track">
                        <i class="fa-solid fa-music text-lg"></i>
                    </button>

                    <!-- Options Overflow Menu -->
                    <button id="btn-menu" class="hover:text-blue-400 text-gray-200 p-1.5 transition-colors" title="More Options">
                        <i class="fa-solid fa-ellipsis-vertical text-lg"></i>
                    </button>
                </div>
            </div>

            <!-- Bottom Section: Seekbar + Main Controls -->
            <div class="w-full flex flex-col space-y-2 sm:space-y-4">
                
                <!-- Seek Bar Row -->
                <div class="flex items-center space-x-3 text-xs sm:text-sm font-mono text-gray-300">
                    <span id="time-current" class="w-12 text-right">00:00</span>
                    <div class="relative flex-1 flex items-center">
                        <div id="progress-filled" class="absolute left-0 top-1/2 -translate-y-1/2 h-1 bg-blue-500 rounded-l pointer-events-none z-0" style="width: 0%;"></div>
                        <input id="progress-bar" type="range" min="0" max="100" value="0" step="0.1" class="mx-progress z-10 relative">
                    </div>
                    <span id="time-duration" class="w-12 text-left">00:00</span>
                </div>

                <!-- Playback Action Bar -->
                <div class="flex items-center justify-between px-2 sm:px-8 py-1">
                    <!-- Screen Lock Toggle Button -->
                    <button id="btn-lock" class="text-gray-300 hover:text-white p-2 transition-colors" title="Lock Controls">
                        <i class="fa-solid fa-lock-open text-lg sm:text-xl"></i>
                    </button>

                    <!-- Center Media Controls (Prev, Play/Pause, Next) -->
                    <div class="flex items-center space-x-6 sm:space-x-10">
                        <!-- Previous Episode -->
                        <button id="btn-prev" class="text-gray-200 hover:text-blue-400 p-2 transition-colors" title="Previous Episode">
                            <i class="fa-solid fa-step-backward text-xl sm:text-2xl"></i>
                        </button>

                        <!-- Main Play / Pause Button -->
                        <button id="btn-play-pause" class="text-white hover:text-blue-400 p-3 transition-colors transform active:scale-95" title="Play / Pause">
                            <i id="play-icon" class="fa-solid fa-play text-2xl sm:text-3xl"></i>
                        </button>

                        <!-- Next Episode -->
                        <button id="btn-next" class="text-gray-200 hover:text-blue-400 p-2 transition-colors" title="Next Episode">
                            <i class="fa-solid fa-step-forward text-xl sm:text-2xl"></i>
                        </button>
                    </div>

                    <!-- Right Controls Group: Playlist Drawer & Fullscreen -->
                    <div class="flex items-center space-x-3">
                        <button id="btn-playlist-toggle" class="text-gray-300 hover:text-blue-400 p-2 transition-colors relative" title="Episodes & Seasons">
                            <i class="fa-solid fa-list-ul text-lg sm:text-xl"></i>
                        </button>
                        <button id="btn-fullscreen" class="text-gray-300 hover:text-white p-2 transition-colors" title="Toggle Fullscreen">
                            <i id="fullscreen-icon" class="fa-solid fa-expand text-lg sm:text-xl"></i>
                        </button>
                    </div>
                </div>
            </div>

        </div>

        <!-- Side Playlist Drawer Overlay -->
        <div id="playlist-drawer" class="absolute top-0 right-0 bottom-0 z-50 w-full sm:w-80 sm:max-w-md bg-black/40 backdrop-blur-md border-l border-white/10 flex flex-col transform translate-x-full transition-transform duration-300 ease-in-out shadow-2xl">
            <!-- Drawer Header with Season & Audio/Translation Selectors -->
            <div class="p-4 border-b border-white/10 flex flex-col space-y-3 bg-white/5">
                <div class="flex items-center justify-between">
                    <div class="flex items-center space-x-2">
                        <i class="fa-solid fa-tv text-blue-400"></i>
                        <h2 class="font-bold text-white tracking-wide text-sm sm:text-base">Media Selector</h2>
                    </div>
                    <button id="btn-close-drawer" class="text-gray-400 hover:text-white p-1 rounded-lg transition-colors">
                        <i class="fa-solid fa-xmark text-lg"></i>
                    </button>
                </div>

                <!-- Season Dropdown -->
                <div class="space-y-1">
                    <label class="text-[10px] font-bold uppercase tracking-wider text-gray-400">Season</label>
                    <div class="relative">
                        <select id="season-select" class="w-full bg-zinc-900/80 text-white text-xs sm:text-sm font-semibold rounded-lg px-3 py-2 border border-white/15 focus:outline-none focus:border-blue-500 appearance-none cursor-pointer pr-8">
                            <!-- Populated via JS -->
                        </select>
                        <div class="absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none text-gray-400 text-xs">
                            <i class="fa-solid fa-chevron-down"></i>
                        </div>
                    </div>
                </div>

                <!-- Translation / Audio Dropdown -->
                <div class="space-y-1">
                    <label class="text-[10px] font-bold uppercase tracking-wider text-gray-400">Audio / Translation</label>
                    <div class="relative">
                        <select id="translation-select" class="w-full bg-zinc-900/80 text-white text-xs sm:text-sm font-semibold rounded-lg px-3 py-2 border border-white/15 focus:outline-none focus:border-blue-500 appearance-none cursor-pointer pr-8">
                            <!-- Populated via JS -->
                        </select>
                        <div class="absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none text-gray-400 text-xs">
                            <i class="fa-solid fa-chevron-down"></i>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Episode List Container Header & Items -->
            <div class="px-4 pt-3 pb-1 flex items-center justify-between">
                <span class="text-[10px] font-bold uppercase tracking-wider text-gray-400">Episodes</span>
                <span id="episode-count" class="text-[10px] text-blue-400 font-semibold"></span>
            </div>
            <div id="episode-list" class="flex-1 overflow-y-auto custom-scrollbar p-3 pt-1 space-y-2">
                <!-- Episodes inserted via JS -->
            </div>
        </div>

    </div>

    <!-- Application Logic Script -->
    <script>
        // Current Active State
        let currentPayload = <%- JSON.stringify(locals) %>;
        let selectedSeasonIndex = 0;
        let selectedTranslationIndex = 0;
        let currentEpisodeIndex = 0;
        
        let isLocked = false;
        let controlsTimeout = null;
        let osdTimeout = null;
        let decoderMode = 'HW';

        // Horizontal Gesture Variables
        let isHorizontalSwipe = false;
        let swipeSeekStart = 0;

        // Clean Up Raw Titles
        function cleanTitle(rawTitle) {
            if (!rawTitle) return "";
            return rawTitle.replace(/\s*\(\s*$/, '').trim();
        }

        // DOM Elements
        const playerContainer = document.getElementById('player-container');
        const video = document.getElementById('main-video');
        const controlsOverlay = document.getElementById('controls-overlay');
        const brightnessOverlay = document.getElementById('brightness-overlay');

        const btnPlayPause = document.getElementById('btn-play-pause');
        const playIcon = document.getElementById('play-icon');
        const btnPrev = document.getElementById('btn-prev');
        const btnNext = document.getElementById('btn-next');
        const btnLock = document.getElementById('btn-lock');
        const unlockBtn = document.getElementById('unlock-btn');
        const btnFullscreen = document.getElementById('btn-fullscreen');
        const fullscreenIcon = document.getElementById('fullscreen-icon');
        const btnDecoder = document.getElementById('btn-decoder');
        const btnAudio = document.getElementById('btn-audio');
        const btnRotate = document.getElementById('btn-rotate');

        const playlistDrawer = document.getElementById('playlist-drawer');
        const btnPlaylistToggle = document.getElementById('btn-playlist-toggle');
        const btnCloseDrawer = document.getElementById('btn-close-drawer');
        const seasonSelect = document.getElementById('season-select');
        const translationSelect = document.getElementById('translation-select');
        const episodeList = document.getElementById('episode-list');

        const loadingOverlay = document.getElementById('loading-overlay');
        const loadingTitle = document.getElementById('loading-title');
        const loadingSubtitle = document.getElementById('loading-subtitle');

        const videoTitle = document.getElementById('video-title');
        const seriesSubtitle = document.getElementById('series-subtitle');
        const timeCurrent = document.getElementById('time-current');
        const timeDuration = document.getElementById('time-duration');
        const progressBar = document.getElementById('progress-bar');

        const centerOsd = document.getElementById('center-osd');
        const osdIcon = document.getElementById('osd-icon');
        const osdText = document.getElementById('osd-text');
        const osdSubtext = document.getElementById('osd-subtext');
        const gestureLayer = document.getElementById('gesture-layer');

        let currentBrightness = 1.0;
        let touchStartX = 0;
        let touchStartY = 0;
        let touchStartVal = 0;
        let isSwiping = false;

        // Initialize Player App
        function initPlayer() {
            // Find current active season
            const currentSeasonIdx = currentPayload.seasons.findIndex(s => s.isCurrent);
            selectedSeasonIndex = currentSeasonIdx !== -1 ? currentSeasonIdx : 0;
            
            populateSeasonSelect();
            renderEpisodeList();
            loadEpisode(0, false);
            resetControlsTimer();
        }

        // Populate Seasons Selector
        function populateSeasonSelect() {
            seasonSelect.innerHTML = '';
            currentPayload.seasons.forEach((season, index) => {
                const opt = document.createElement('option');
                opt.value = index;
                const cleanedName = cleanTitle(season.title);
                opt.textContent = season.isCurrent ? `${cleanedName} ★` : cleanedName;
                seasonSelect.appendChild(opt);
            });
            seasonSelect.value = selectedSeasonIndex;
        }

        // Season Switch with Mock Loader
        function changeSeason(newSeasonIndex) {
            newSeasonIndex = parseInt(newSeasonIndex, 10);
            if (newSeasonIndex === selectedSeasonIndex) return;

            const targetSeason = currentPayload.seasons[newSeasonIndex];
            showLoader(`Loading ${cleanTitle(targetSeason.title)}...`, "Fetching playlist");
            
            setTimeout(() => {
                selectedSeasonIndex = newSeasonIndex;
                currentEpisodeIndex = 0;
                populateSeasonSelect();
                renderEpisodeList();
                loadEpisode(0, true);
                hideLoader();
            }, 600);
        }

        // Render Translations Header & Playlist Items
        function renderEpisodeList() {
            episodeList.innerHTML = '';
            
            // 1. Render Translation Dropdown Options
            if (translationSelect) {
                translationSelect.innerHTML = '';
                if (currentPayload.currentSeasonPlaylists && currentPayload.currentSeasonPlaylists.length > 0) {
                    currentPayload.currentSeasonPlaylists.forEach((trans, idx) => {
                        const opt = document.createElement('option');
                        opt.value = idx;
                        opt.textContent = ` ${trans.translation} (${trans.plist.length} eps)`;
                        translationSelect.appendChild(opt);
                    });
                    translationSelect.value = selectedTranslationIndex;
                }
            }

            // 2. Active Episode List
            const activePlaylist = currentPayload.currentSeasonPlaylists[selectedTranslationIndex]?.plist || [];
            
            const countLabel = document.getElementById('episode-count');
            if (countLabel) countLabel.textContent = `${activePlaylist.length} available`;

            if (activePlaylist.length === 0) {
                const emptyMsg = document.createElement('div');
                emptyMsg.className = "text-center text-xs text-gray-400 py-6";
                emptyMsg.textContent = "No episodes found for this translation.";
                episodeList.appendChild(emptyMsg);
                return;
            }

            activePlaylist.forEach((ep, index) => {
                const isPlaying = index === currentEpisodeIndex;
                const item = document.createElement('div');
                item.className = `flex items-center space-x-3 p-3 rounded-xl border transition-all cursor-pointer backdrop-blur-sm ${
                    isPlaying 
                        ? 'bg-blue-600/30 border-blue-500/60 text-white' 
                        : 'bg-black/30 border-white/10 text-gray-200 hover:bg-white/10 hover:border-white/20'
                }`;

                item.innerHTML = `
                    <div class="relative w-10 h-9 bg-black/40 rounded-lg flex-shrink-0 flex items-center justify-center border border-white/10">
                        <i class="fa-solid ${isPlaying ? 'fa-circle-play text-blue-400' : 'fa-film text-gray-400'} text-sm"></i>
                    </div>
                    <div class="flex-1 min-w-0">
                        <p class="text-xs font-semibold truncate text-gray-100">${ep.title}</p>
                    </div>
                `;

                item.addEventListener('click', () => {
                    loadEpisode(index, true, 0);
                    closeDrawer();
                });

                episodeList.appendChild(item);
            });
        }

        // Load Specific Episode (supports initial position timestamp)
        function loadEpisode(epIdx, autoPlay = true, startTime = 0) {
            const playlist = currentPayload.currentSeasonPlaylists[selectedTranslationIndex]?.plist || [];
            if (!playlist[epIdx]) return;

            currentEpisodeIndex = epIdx;
            const ep = playlist[epIdx];
            const currentSeasonTitle = cleanTitle(currentPayload.seasons[selectedSeasonIndex]?.title || "Season");
            const translationName = currentPayload.currentSeasonPlaylists[selectedTranslationIndex]?.translation || "";

            video.src = ep.file;
            videoTitle.textContent = ep.title;
            seriesSubtitle.textContent = `${currentSeasonTitle} • ${translationName}`;

            renderEpisodeList();
            video.load();

            // Set seek position once video metadata is ready
            if (startTime > 0) {
                const setTimeHandler = () => {
                    video.currentTime = startTime;
                    video.removeEventListener('loadedmetadata', setTimeHandler);
                };
                video.addEventListener('loadedmetadata', setTimeHandler);
            }

            if (autoPlay) {
                video.play().then(() => { updatePlayIcon(true); }).catch((err ) => { updatePlayIcon(false); });
            } else {
                updatePlayIcon(false);
            }
        }

        // Toggle Play / Pause state
        function togglePlayPause() {
            if (video.paused || video.ended) {
                video.play().then(() => updatePlayIcon(true)).catch(() => updatePlayIcon(false));
            } else {
                video.pause();
                updatePlayIcon(false);
            }
        }

        // Update Play / Pause Icon in UI
        function updatePlayIcon(isPlaying) {
            if (isPlaying) {
                playIcon.classList.remove('fa-play');
                playIcon.classList.add('fa-pause');
            } else {
                playIcon.classList.remove('fa-pause');
                playIcon.classList.add('fa-play');
            }
        }

        // Helper: Format Time in MM:SS or HH:MM:SS
        function formatTime(seconds) {
            if (isNaN(seconds) || seconds === Infinity) return "00:00";
            const sec = Math.floor(seconds % 60);
            const min = Math.floor((seconds / 60) % 60);
            const hrs = Math.floor(seconds / 3600);

            const pad = (num) => String(num).padStart(2, '0');

            if (hrs > 0) {
                return `${pad(hrs)}:${pad(min)}:${pad(sec)}`;
            }
            return `${pad(min)}:${pad(sec)}`;
        }

        // Loader Overlay Controls
        function showLoader(title = "Loading...", subtitle = "Please wait") {
            loadingTitle.textContent = title;
            loadingSubtitle.textContent = subtitle;
            loadingOverlay.classList.remove('opacity-0', 'pointer-events-none');
            loadingOverlay.classList.add('opacity-100');
        }

        function hideLoader() {
            loadingOverlay.classList.remove('opacity-100');
            loadingOverlay.classList.add('opacity-0', 'pointer-events-none');
        }

        // Audio Track Quick Picker OSD Toggle
        btnAudio.addEventListener('click', () => {
            const translations = currentPayload.currentSeasonPlaylists;
            if (!translations || translations.length === 0) return;
            
            const currentTime = video.currentTime || 0;
            selectedTranslationIndex = (selectedTranslationIndex + 1) % translations.length;
            const newTrans = translations[selectedTranslationIndex];
            
            renderEpisodeList();
            loadEpisode(currentEpisodeIndex, !video.paused, currentTime);
            showOSD('fa-language', newTrans.translation, 'Audio Track');
        });

        // Previous & Next Episode Controls
        function playPrevEpisode() {
            if (currentEpisodeIndex > 0) {
                loadEpisode(currentEpisodeIndex - 1, true, 0);
            } else {
                showOSD('fa-step-backward', 'First Episode');
            }
        }

        function playNextEpisode() {
            const playlist = currentPayload.currentSeasonPlaylists[selectedTranslationIndex]?.plist || [];
            if (currentEpisodeIndex < playlist.length - 1) {
                loadEpisode(currentEpisodeIndex + 1, true, 0);
            } else {
                showOSD('fa-step-forward', 'End of Playlist');
            }
        }

        btnPrev.addEventListener('click', playPrevEpisode);
        btnNext.addEventListener('click', playNextEpisode);

        // Toggle Drawer
        function openDrawer() {
            playlistDrawer.classList.remove('translate-x-full');
        }

        function closeDrawer() {
            playlistDrawer.classList.add('translate-x-full');
        }

        btnPlaylistToggle.addEventListener('click', (e) => {
            e.stopPropagation();
            if (playlistDrawer.classList.contains('translate-x-full')) {
                openDrawer();
            } else {
                closeDrawer();
            }
        });

        btnCloseDrawer.addEventListener('click', closeDrawer);
        seasonSelect.addEventListener('change', (e) => changeSeason(e.target.value));

        // Translation Selector Change Listener
        translationSelect.addEventListener('change', (e) => {
            const newIndex = parseInt(e.target.value, 10);
            if (selectedTranslationIndex !== newIndex) {
                const currentTime = video.currentTime || 0;
                selectedTranslationIndex = newIndex;
                const activePlaylist = currentPayload.currentSeasonPlaylists[selectedTranslationIndex]?.plist || [];
                if (currentEpisodeIndex >= activePlaylist.length) {
                    currentEpisodeIndex = 0;
                }
                renderEpisodeList();
                loadEpisode(currentEpisodeIndex, !video.paused, currentTime);
            }
        });

        // Toggle Fullscreen
        function toggleFullscreen() {
            if (!document.fullscreenElement) {
                if (playerContainer.requestFullscreen) {
                    playerContainer.requestFullscreen();
                } else if (playerContainer.webkitRequestFullscreen) {
                    playerContainer.webkitRequestFullscreen();
                }
                fullscreenIcon.classList.remove('fa-expand');
                fullscreenIcon.classList.add('fa-compress');
            } else {
                if (document.exitFullscreen) {
                    document.exitFullscreen();
                }
                fullscreenIcon.classList.remove('fa-compress');
                fullscreenIcon.classList.add('fa-expand');
            }
        }

        btnFullscreen.addEventListener('click', toggleFullscreen);

        // Decoder Toggle
        btnDecoder.addEventListener('click', () => {
            decoderMode = decoderMode === 'HW' ? 'SW' : 'HW';
            btnDecoder.textContent = decoderMode;
            showOSD('fa-microchip', `${decoderMode} Decoder`);
        });

        // Rotation Toggle Simulation
        btnRotate.addEventListener('click', () => {
            showOSD('fa-rotate', 'Screen Rotated');
        });

        // Show OSD Overlay Helper
        function showOSD(iconClass, text, subtext = '') {
            osdIcon.className = `fa-solid ${iconClass} text-4xl mb-2 text-white`;
            osdText.textContent = text;
            if (subtext) {
                osdSubtext.textContent = subtext;
                osdSubtext.classList.remove('hidden');
            } else {
                osdSubtext.classList.add('hidden');
            }

            centerOsd.classList.remove('opacity-0', 'scale-95');
            centerOsd.classList.add('opacity-100', 'scale-100');

            clearTimeout(osdTimeout);
            osdTimeout = setTimeout(() => {
                centerOsd.classList.remove('opacity-100', 'scale-100');
                centerOsd.classList.add('opacity-0', 'scale-95');
            }, 1200);
        }

        // Auto Hide Controls Logic
        function resetControlsTimer() {
            if (isLocked) return;
            controlsOverlay.classList.remove('opacity-0', 'pointer-events-none');
            controlsOverlay.classList.add('opacity-100');
            
            clearTimeout(controlsTimeout);
            controlsTimeout = setTimeout(() => {
                if (!video.paused && playlistDrawer.classList.contains('translate-x-full')) {
                    controlsOverlay.classList.remove('opacity-100');
                    controlsOverlay.classList.add('opacity-0', 'pointer-events-none');
                }
            }, 3500);
        }

        // Toggle Controls Display on Container Click/Tap
        gestureLayer.addEventListener('click', () => {
            if (!playlistDrawer.classList.contains('translate-x-full')) {
                closeDrawer();
                return;
            }

            if (isLocked) {
                unlockBtn.classList.remove('hidden');
                setTimeout(() => {
                    if (isLocked) unlockBtn.classList.add('hidden');
                }, 2000);
                return;
            }

            if (controlsOverlay.classList.contains('opacity-0')) {
                resetControlsTimer();
            } else {
                controlsOverlay.classList.remove('opacity-100');
                controlsOverlay.classList.add('opacity-0', 'pointer-events-none');
            }
        });

        // Screen Lock Feature
        btnLock.addEventListener('click', () => {
            isLocked = true;
            closeDrawer();
            controlsOverlay.classList.add('opacity-0', 'pointer-events-none');
            unlockBtn.classList.remove('hidden');
            showOSD('fa-lock', 'Screen Locked');
        });

        unlockBtn.addEventListener('click', () => {
            isLocked = false;
            unlockBtn.classList.add('hidden');
            controlsOverlay.classList.remove('opacity-0', 'pointer-events-none');
            controlsOverlay.classList.add('opacity-100');
            resetControlsTimer();
            showOSD('fa-lock-open', 'Screen Unlocked');
        });

        // Touch Drag Gestures (Left = Brightness, Right = Volume, Horizontal = Seek)
        function setupTouchGestures() {
            let activeSide = null; // 'left' or 'right'

            playerContainer.addEventListener('touchstart', (e) => {
                if (isLocked) return;
                const touch = e.touches[0];
                const rect = playerContainer.getBoundingClientRect();
                const x = touch.clientX - rect.left;
                
                touchStartX = touch.clientX;
                touchStartY = touch.clientY;
                isSwiping = true;
                isHorizontalSwipe = false;

                if (x < rect.width / 2) {
                    activeSide = 'left';
                    touchStartVal = currentBrightness;
                } else {
                    activeSide = 'right';
                    touchStartVal = video.volume;
                }
            }, { passive: true });

            playerContainer.addEventListener('touchmove', (e) => {
                if (!isSwiping || isLocked) return;

                const touch = e.touches[0];
                const deltaX = touch.clientX - touchStartX;
                const deltaY = touchStartY - touch.clientY;

                // Detect horizontal swipe gesture
                if (!isHorizontalSwipe && Math.abs(deltaX) > Math.abs(deltaY) && Math.abs(deltaX) > 20) {
                    isHorizontalSwipe = true;
                    swipeSeekStart = video.currentTime;
                }

                if (isHorizontalSwipe) {
                    // Horizontal Seek Gesture
                    const seekDelta = (deltaX / playerContainer.clientWidth) * 90; // scale drag relative to width
                    const targetTime = Math.max(0, Math.min(video.duration, swipeSeekStart + seekDelta));
                    video.currentTime = targetTime;
                    const sign = seekDelta >= 0 ? '+' : '';
                    showOSD('fa-arrow-right-arrow-left', formatTime(targetTime), `${sign}${Math.round(seekDelta)}s`);
                    return;
                }

                // Vertical Gestures
                const sensitivity = 0.005;

                if (activeSide === 'left') {
                    let newBrightness = touchStartVal + (deltaY * sensitivity);
                    newBrightness = Math.max(0.2, Math.min(1.0, newBrightness));
                    currentBrightness = newBrightness;

                    const darkness = 1 - currentBrightness;
                    brightnessOverlay.style.backgroundColor = `rgba(0, 0, 0, ${darkness})`;

                    const pct = Math.round(currentBrightness * 100);
                    showOSD('fa-sun', `${pct}%`, 'Brightness');
                } else if (activeSide === 'right') {
                    let newVolume = touchStartVal + (deltaY * sensitivity);
                    newVolume = Math.max(0, Math.min(1.0, newVolume));
                    video.volume = newVolume;

                    const pct = Math.round(newVolume * 100);
                    const volIcon = pct === 0 ? 'fa-volume-mute' : (pct > 50 ? 'fa-volume-high' : 'fa-volume-low');
                    showOSD(volIcon, `${pct}%`, 'Volume');
                }
            }, { passive: true });

            playerContainer.addEventListener('touchend', () => {
                isSwiping = false;
                isHorizontalSwipe = false;
                activeSide = null;
            });
        }

        // Control Events Listeners
        btnPlayPause.addEventListener('click', togglePlayPause);
        playerContainer.addEventListener('mousemove', resetControlsTimer);

        // Video Progress and Time Updates
        const progressFilled = document.getElementById('progress-filled');

        video.addEventListener('timeupdate', () => {
            if (!isNaN(video.duration) && video.duration > 0) {
                const progressPct = (video.currentTime / video.duration) * 100;
                progressBar.value = progressPct;
                if (progressFilled) {
                    progressFilled.style.width = `${progressPct}%`;
                }
                timeCurrent.textContent = formatTime(video.currentTime);
            }
        });

        video.addEventListener('loadedmetadata', () => {
            timeDuration.textContent = formatTime(video.duration);
        });

        progressBar.addEventListener('input', () => {
            if (!isNaN(video.duration) && video.duration > 0) {
                const seekTime = (progressBar.value / 100) * video.duration;
                video.currentTime = seekTime;
                if (progressFilled) {
                    progressFilled.style.width = `${progressBar.value}%`;
                }
            }
        });

        video.addEventListener('ended', () => {
            updatePlayIcon(false);
            playNextEpisode();
        });

        // Keyboard Shortcuts
        document.addEventListener('keydown', (e) => {
            if (isLocked) return;
            switch(e.key.toLowerCase()) {
                case ' ':
                case 'k':
                    togglePlayPause();
                    resetControlsTimer();
                    break;
                case 'f':
                    toggleFullscreen();
                    break;
                case 'n':
                    playNextEpisode();
                    break;
                case 'p':
                    playPrevEpisode();
                    break;
                case 'arrowleft':
                    video.currentTime = Math.max(0, video.currentTime - 5);
                    showOSD('fa-backward', '-5s');
                    resetControlsTimer();
                    break;
                case 'arrowright':
                    video.currentTime = Math.min(video.duration, video.currentTime + 5);
                    showOSD('fa-forward', '+5s');
                    resetControlsTimer();
                    break;
                case 'arrowup':
                    video.volume = Math.min(1, video.volume + 0.1);
                    showOSD('fa-volume-high', `${Math.round(video.volume * 100)}%`);
                    break;
                case 'arrowdown':
                    video.volume = Math.max(0, video.volume - 0.1);
                    showOSD('fa-volume-low', `${Math.round(video.volume * 100)}%`);
                    break;
            }
        });

        // Initialize on DOM load
        window.onload = () => {
            initPlayer();
            setupTouchGestures();
        };
    </script>
</body>
</html>