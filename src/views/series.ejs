<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title><%= title %></title>
    <link href="https://vjs.zencdn.net/8.6.1/video-js.css" rel="stylesheet" />
    <script src="https://vjs.zencdn.net/8.6.1/video.min.js"></script>
    
    <style>
        body { font-family: -apple-system, sans-serif; background: #121212; color: #e0e0e0; margin: 0; padding: 0; }
        .header { display: flex; align-items: center; padding: 15px; background: #1e1e1e; position: sticky; top: 0; z-index: 10; }
        .back-btn { color: #ff9800; text-decoration: none; font-size: 24px; margin-right: 15px; }
        h1 { font-size: 18px; margin: 0; line-height: 1.2; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        
        /* Video Container Setup */
        .video-container { 
            width: 100%; 
            aspect-ratio: 16/9; 
            background: #000; 
            position: relative;
        }
        .video-js { width: 100%; height: 100%; }

        /* ==========================================
           1. HIDE NATIVE PLAY BUTTONS
           ========================================== */
        
        /* Hide the play button in the bottom bar */
        .video-js .vjs-play-control {
            display: none !important;
        }
        
        /* Hide the center native big play button (we use our own overlay) */
        .video-js .vjs-big-play-button {
            display: none !important;
        }

        /* ==========================================
           2. CUSTOM CLICK LAYER (70% of screen)
           ========================================== */
        
        .custom-click-layer {
            position: absolute;
            top: 0; left: 0; right: 0; 
            height: 70%; /* Takes up the top 70% */
            z-index: 10;
            cursor: pointer;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        /* The giant play icon that shows when paused */
        .giant-play-icon {
            font-size: 80px;
            color: rgba(255, 255, 255, 0.9);
            text-shadow: 0 4px 15px rgba(0,0,0,0.6);
            transition: opacity 0.2s;
            pointer-events: none;
        }

        /* Hide the icon when playing */
        .custom-click-layer.playing .giant-play-icon {
            opacity: 0;
        }

        /* ==========================================
           3. STYLE THE BOTTOM CONTROL BAR (30% of screen)
           ========================================== */
        
        /* Keep the bottom bar clean and standard */
        .video-js .vjs-control-bar {
            height: 3.5em !important; /* Standard nice height */
            background: linear-gradient(to top, rgba(0,0,0,0.95), transparent) !important;
            align-items: center !important;
        }

        /* Full-width progress bar pinned to the bottom */
        .video-js .vjs-progress-control {
            position: absolute !important;
            bottom: 0 !important;
            left: 0 !important;
            width: 100% !important;
            height: 20px !important;
            margin: 0 !important;
        }
        .video-js .vjs-progress-holder {
            height: 6px !important;
            margin: 0 !important;
        }
        .video-js .vjs-play-progress:before {
            font-size: 18px !important;
            top: -6px !important;
        }

        /* Enlarge time, volume, fullscreen */
        .video-js .vjs-time-control,
        .video-js .vjs-volume-panel,
        .video-js .vjs-fullscreen-control,
        .video-js .vjs-playback-rate {
            font-size: 16px !important;
            margin-bottom: 10px !important; /* Lift above progress bar */
        }

        /* Episode List */
        .episode-list { list-style: none; padding: 15px; margin: 0; }
        .episode-item { background: #1e1e1e; padding: 15px; margin-bottom: 10px; border-radius: 8px; cursor: pointer; display: flex; justify-content: space-between; align-items: center; border-left: 4px solid transparent; }
        .episode-item.active { border-left-color: #ff9800; background: #2a2a2a; }
        .error-box { background: #d32f2f; color: white; padding: 20px; text-align: center; margin: 20px; border-radius: 8px; }
        
        /* Seasons Section Styles */
        .seasons-section {
            background: #1e1e1e;
            border-radius: 8px;
            padding: 15px;
            margin: 20px 0;
        }
        .seasons-list {
            list-style: none;
            padding: 0;
            margin: 0;
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
        }
        .season-item {
            background: #2a2a2a;
            padding: 10px 15px;
            border-radius: 5px;
            cursor: pointer;
            transition: background 0.2s;
            text-decoration: none;
            color: #e0e0e0;
            display: inline-block;
        }
        .season-item:hover {
            background: #3a3a3a;
        }
        .season-item.current {
            background: #ff9800;
            color: #121212;
            font-weight: bold;
        }
        .season-item.current:hover {
            background: #ffb74d;
        }
    </style>
</head>
<body>
    <div class="header">
        <a href="/" class="back-btn">&larr;</a>
        <h1><%= title %></h1>
    </div>

    <% if (episodes.length > 0) { %>
        <div class="video-container" id="videoContainer">
            <!-- Video.js (native controls are active, but CSS hides the play buttons) -->
            <video id="my-player" class="video-js" controls preload="auto" playsinline data-setup='{}'>
                <p class="vjs-no-js">To view this video please enable JavaScript.</p>
            </video>
            
            <!-- Our custom giant click area for Play/Pause -->
            <div class="custom-click-layer playing" id="clickLayer">
                <div class="giant-play-icon">▶</div>
            </div>
        </div>

        <!-- Seasons List -->
        <% if (seasons && seasons.length > 0) { %>
            <div class="seasons-section" style="margin: 20px 0; padding: 15px; background: #1e1e1e; border-radius: 8px;">
                <h3 style="margin: 0 0 10px 0; color: #e0e0e0;">Сезоны</h3>
                <ul class="seasons-list" style="list-style: none; padding: 0; margin: 0;">
                    <% seasons.forEach(function(season, index) { %>
                        <li class="season-item <%= season.isCurrent ? 'current' : '' %>" 
                            data-url="/series?url=<%= encodeURIComponent(season.link) %>&title=<%= encodeURIComponent(season.title) %>"
                            onclick="navigateToSeason(this)">
                            <span><%= season.title %></span>
                            <% if (season.isCurrent) { %>
                                <span style="color: #ff9800; margin-left: 10px;">(текущий сезон)</span>
                            <% } %>
                        </li>
                    <% }); %>
                </ul>
            </div>
        <% } %>

        <ul class="episode-list">
            <% episodes.forEach(function(ep, index) { %>
                <li class="episode-item <%= index === 0 ? 'active' : '' %>" 
                    data-url="<%= ep.file%>"
                    onclick="playEpisode(this)">
                    <span><%- ep.title %></span>
                    <span style="color: #ff9800;">▶</span>
                </li>
            <% }); %>
        </ul>
    <% } else { %>
        <div class="error-box"><p><%= error || 'No episodes found or links could not be decoded.' %></p></div>
    <% } %>

    <script>
        // Initialize Video.js
        const player = videojs('my-player', {
            controls: true,
            fluid: false,
            playbackRates: [0.5, 1, 1.5, 2]
        });

        const clickLayer = document.getElementById('clickLayer');

        // 1. Click anywhere in the top 70% to Play/Pause
        clickLayer.addEventListener('click', (e) => {
            // Prevent click if clicking native controls (though they are at the bottom)
            if (e.target.closest('.vjs-control-bar')) return;

            if (player.paused()) {
                player.play();
            } else {
                player.pause();
            }
        });

        // 2. Manage the Giant Play Icon visibility
        player.on('play', () => {
            clickLayer.classList.add('playing'); // Hides icon
        });
        
        player.on('pause', () => {
            clickLayer.classList.remove('playing'); // Shows icon
        });

        // 3. Handle Fullscreen
        player.on('fullscreenchange', () => {
            if (player.isFullscreen()) {
                clickLayer.style.height = '100%'; // Cover whole screen in fullscreen
            } else {
                clickLayer.style.height = '70%'; // Back to 70% in normal mode
            }
        });

        function playEpisode(element) {
            document.querySelectorAll('.episode-item').forEach(el => el.classList.remove('active'));
            element.classList.add('active');
            const videoUrl = element.getAttribute('data-url');
            if (videoUrl) {
                player.src({ type: 'video/mp4', src: videoUrl });
                player.play().catch(e => console.log('Autoplay prevented:', e));
                window.scrollTo({ top: 0, behavior: 'smooth' });
            }
        }

        function navigateToSeason(element) {
            document.querySelectorAll('.season-item').forEach(el => el.classList.remove('current'));
            element.classList.add('current');
            const url = element.getAttribute('data-url');
            if (url) {
                window.location.href = url;
            }
        }

        document.addEventListener('DOMContentLoaded', () => {
            const firstEpisode = document.querySelector('.episode-item');
            if (firstEpisode) playEpisode(firstEpisode);
        });
    </script>
</body>
</html>