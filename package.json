{
  "name": "svm",
  "version": "1.0.0",
  "description": "",
  "main": "src/server.js",
  "scripts": {
    "test": "node --test \"tests/**/*.test.js\"",
    "test:be": "node --test \"tests/be/**/*.test.js\"",
    "test:fe": "node --test \"tests/fe/**/*.test.js\"",
    "start": "bun run build:fe && bun run build:be && bun dist/svm.js",
    "build:fe": "bunx --bun vite build --config vite.config.fe.js",
    "build:be": "bunx --bun vite build --config vite.config.be.js",
    "build": "bun install && bun test && bun run build:fe && bun run build:be",
    "dev:fe": "bunx --bun vite --config vite.config.fe.js",
    "dev:be": "bun src/server.js",
    "deploy": "bun scripts/deploy.js",
    "check": "tsc"
  },
  "keywords": [],
  "type": "module",
  "dependencies": {
    "@solidjs/router": "^1.0.0",
    "cheerio": "^1.2.0",
    "express": "^5.3.0",
    "htmlparser2": "^10.0.0",
    "solid-js": "^1.9.17"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-solid": "^2.11.14"
  }
}
