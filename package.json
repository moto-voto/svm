{
  "name": "svm3",
  "version": "1.0.0",
  "description": "",
  "main": "src/server.js",
  "scripts": {
    "test": "node --test \"tests/**/*.test.js\"",
    "test:be": "node --test \"tests/be/**/*.test.js\"",
    "test:fe": "node --test \"tests/fe/**/*.test.js\"",
    "start": "npm run build:fe && npm run build:be && node dist/svm.js",
    "build:fe": "vite build --config vite.config.fe.js",
    "build:be": "vite build --config vite.config.be.js",
    "build": "npm install --no-audit --no-fund && npm run test && npm run build:fe && npm run build:be",
    "dev:fe": "vite --config vite.config.fe.js",
    "dev:be": "node src/server.js",
    "predeploy": "npm run test && npm run build:be && npm run build:fe",
    "deploy": "node scripts/deploy.js",
    "check": "tsc"
  },
  "keywords": [],
  "type": "module",
  "dependencies": {
    "@solidjs/router": "^1.0.0",
    "cheerio": "^1.2.0",
    "express": "^5.3.0",
    "solid-js": "^1.9.17"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-solid": "^2.11.14"
  }
}
