{
  "name": "svm",
  "version": "1.0.0",
  "description": "",
  "main": "src/server.js",
  "scripts": {
    "test": "node --test \"tests/**/*.test.js\"",
    "test:be": "node --test \"tests/be/**/*.test.js\"",
    "test:fe": "node --test \"tests/fe/**/*.test.js\"",
    "start": "bun run build:fe:bun && bun run build:be:bun && bun dist/svm.js",
    "build:fe": "bunx --bun vite build --config vite.config.fe.js",
    "build:fe:bun": "bun bun-solidjs/build.js",
    "build:be": "bunx --bun vite build --config vite.config.be.js",
    "build:be:bun": "bun build --minify --target node --outfile dist/svm.js src/server.js",
    "build": "bun install && bun test && bun run build:fe && bun run build:be",
    "dev:fe": "bunx --bun vite --config vite.config.fe.js",
    "dev:be": "bun src/server.js",
    "deploy": "bun scripts/deploy.js"
  },
  "keywords": [],
  "type": "module",
  "dependencies": {
    "@solidjs/router": "^1.0.0",
    "cheerio": "^1.2.0",
    "express": "^5.3.0",
    "htmlparser2": "^10.0.0",
    "solid-js": "^1.9.17"
  },
  "devDependencies": {
    "@babel/core": "^8.1.0",
    "@babel/preset-typescript": "^8.0.7",
    "@solidjs/compiler": "^2.0.0-rc.2",
    "@solidjs/compiler-wasm32-wasi": "^2.0.0-rc.2",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "babel-preset-solid": "^1.9.16",
    "esbuild": "^0.28.2",
    "solid-refresh": "^0.6.3",
    "vite": "^8.3.5",
    "vite-plugin-solid": "^2.11.14"
  }
}
