<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Seasonvar Mobile</title>
    <style>
        body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; background: #121212; color: #e0e0e0; margin: 0; padding: 15px; }
        h1 { font-size: 24px; color: #ff9800; text-align: center; margin-bottom: 20px; }
        form { display: flex; margin-bottom: 20px; }
        input[type="text"] { flex: 1; padding: 12px; border: none; border-radius: 8px 0 0 8px; font-size: 16px; background: #2c2c2c; color: #fff; }
        button { padding: 12px 20px; border: none; border-radius: 0 8px 8px 0; background: #ff9800; color: #000; font-weight: bold; font-size: 16px; cursor: pointer; }
        
        /* Search Result Card */
        .list-item { 
            background: #1e1e1e; 
            margin-bottom: 12px; 
            border-radius: 8px; 
            text-decoration: none; 
            color: #fff; 
            display: flex;
            overflow: hidden;
            border-left: 4px solid #ff9800;
        }
        .list-item:hover { background: #2a2a2a; }
        
        /* Image Container */
        .item-image {
            width: 90px;
            min-width: 90px;
            height: 135px;
            background: #000;
        }
        .item-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        /* Text Container */
        .item-info {
            padding: 12px;
            display: flex;
            flex-direction: column;
            justify-content: flex-start;
        }
        .item-title {
            font-size: 16px;
            font-weight: bold;
            color: #ff9800;
            margin-bottom: 6px;
            line-height: 1.2;
        }
        .item-desc {
            font-size: 13px;
            color: #aaa;
            line-height: 1.4;
            /* Limit description to 4 lines */
            display: -webkit-box;
            -webkit-line-clamp: 4;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .error { background: #d32f2f; color: white; padding: 10px; border-radius: 5px; margin-bottom: 15px; text-align: center; }
        .empty { text-align: center; color: #888; margin-top: 50px; }
    </style>
</head>
<body>
    <h1>Seasonvar Mobile</h1>

    <form action="/" method="GET">
        <input type="text" name="q" placeholder="Поиск сериала..." value="<%= query %>" required>
        <button type="submit">Go</button>
    </form>

    <% if (error) { %>
        <div class="error"><%= error %></div>
    <% } %>

    <% if (results.length > 0) { %>
        <% results.forEach(function(movie) { %>
            <a href="/serial?url=<%= encodeURIComponent(movie.fullLink) %>&title=<%= encodeURIComponent(movie.title) %>" class="list-item">
                <div class="item-image">
                    <% if (movie.image) { %>
                        <img src="<%= movie.image %>" alt="<%= movie.title %>" loading="lazy">
                    <% } else { %>
                        <!-- Placeholder if no image -->
                        <div style="width:100%; height:100%; display:flex; align-items:center; justify-content:center; color:#444;">No IMG</div>
                    <% } %>
                </div>
                <div class="item-info">
                    <div class="item-title"><%= movie.title %></div>
                    <% if (movie.description) { %>
                        <div class="item-desc"><%= movie.description %></div>
                    <% } %>
                </div>
            </a>
        <% }); %>
    <% } else if (query) { %>
        <div class="empty">По запросу "<%= query %>" ничего не найдено.</div>
    <% } else { %>
        <div class="empty">Введите название сериала для поиска.</div>
    <% } %>
</body>
</html>